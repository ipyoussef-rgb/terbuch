# Database (Neon Postgres free tier — use the pooled connection string)
DATABASE_URL=

# KOBIL Identity (issuer + .well-known)
KOBIL_IDP_ISSUER=https://idp.gondor-pt-cityappdev-pgbuy.gondor.dev.kobil.com/auth/realms/wormsdev

# User UI OIDC client
KOBIL_USER_CLIENT_ID=
KOBIL_USER_CLIENT_SECRET=

# Admin UI OIDC client
KOBIL_ADMIN_CLIENT_ID=
KOBIL_ADMIN_CLIENT_SECRET=

# KOBIL Chat (server-to-server, client_credentials)
KOBIL_CHAT_CLIENT_ID=
KOBIL_CHAT_CLIENT_SECRET=
KOBIL_MERCURY_BASE=https://mercury.gondor-pt-cityappdev-pgbuy.gondor.dev.kobil.com
# Service UUID of the chat app (the "service" the chatbot is registered as)
KOBIL_CHAT_SERVICE_UUID=
# Optional: override the send-message path template if Mercury uses a different shape.
# {serviceUuid} and {userId} are substituted.
KOBIL_CHAT_SEND_PATH=/api/v1/services/{serviceUuid}/users/{userId}/messages

# Webhook shared secret — register this header value with Mercury for webhook auth.
# If unset, the webhook does not verify origin (development only).
KOBIL_WEBHOOK_SECRET=

# Session cookie signing secret — generate via: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this app (Vercel sets VERCEL_URL automatically; override if needed)
APP_BASE_URL=

# Vercel Cron shared secret — set this AND in Vercel project env.
CRON_SECRET=
