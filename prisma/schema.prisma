// Prisma schema for terbuch — appointment booking
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  options   ServiceOption[]
  slots     Slot[]
  offices   Office[]        @relation("OfficeServices")
}

model ServiceOption {
  id           String        @id @default(cuid())
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  durationMin  Int           @default(30)
  appointments Appointment[]
}

model Office {
  id         String    @id @default(cuid())
  name       String
  city       String
  street     String
  postalCode String
  lat        Float
  lng        Float
  services   Service[] @relation("OfficeServices")
  slots      Slot[]
}

enum SlotStatus {
  FREE
  PENDING
  BOOKED
  BLOCKED
}

model Slot {
  id          String       @id @default(cuid())
  officeId    String
  office      Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  status       SlotStatus    @default(FREE)
  appointments Appointment[]

  @@unique([officeId, serviceId, startsAt])
  @@index([officeId, serviceId, startsAt])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Appointment {
  id              String            @id @default(cuid())
  slotId          String
  slot            Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  serviceOptionId String
  serviceOption   ServiceOption     @relation(fields: [serviceOptionId], references: [id])

  kobilSub   String
  firstName  String
  lastName   String
  email      String
  phone      String?
  birthdate  DateTime?
  street     String
  postalCode String
  city       String

  status          AppointmentStatus @default(PENDING)
  privacyAccepted Boolean
  createdAt       DateTime          @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  chatThreadId    String?
  chatInitError   String?

  // Payment workflow (Sachbearbeiter triggers via /admin/api/payment-request)
  paymentAmountCents     Int?
  paymentCurrency        String?
  paymentRequestedAt     DateTime?
  paymentChoice          String?               // "online" | "onsite" | null
  paymentTransactionId   String?
  paymentStatus          String?               // SUCCESS | FAILED | PENDING | CANCELLED | INITIATED
  paymentLastCheckedAt   DateTime?
  paymentRawStatus       String?               // last raw status field from Pay API

  messages ChatMessage[]

  @@index([kobilSub])
  @@index([email])
  @@index([slotId])
  @@index([status])
  @@index([createdAt])
}

enum MessageDirection {
  OUT
  IN
}

model ChatMessage {
  id            String           @id @default(cuid())
  appointmentId String
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  direction     MessageDirection
  type          String
  body          String
  createdAt     DateTime         @default(now())

  @@index([appointmentId, createdAt])
}
